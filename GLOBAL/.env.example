# CoreCS Global operator settings. Copy to .env (scripts/run_platform.ps1 loads it) or export.

# Where jobs, uploads, bundles and the SQLite DB live (default: ./data). Bundles are GBs each.
# GLOBAL_DATA_DIR=D:\corecs-global-data

# Interpreter with torch + CUDA + requirements-train.txt, used for the train/package stages.
# Defaults to the interpreter running the worker.
# GLOBAL_TRAIN_PYTHON=C:\path\to\train-venv\Scripts\python.exe

# llama.cpp toolchain (llama.cpp-src + llama.cpp-bin). Default: ./tools (scripts/setup_toolchain.py)
# GLOBAL_TOOLCHAIN_DIR=C:\path\to\tools

# Optional prebuilt desktop installer to include in bundles. Auto-detected from
# runtime/desktop/src-tauri/target/release/bundle/nsis/*-setup.exe when unset.
# GLOBAL_DESKTOP_INSTALLER=C:\path\to\CoreCS_0.1.0_x64-setup.exe

# Require this token for the web UI / API (recommended whenever the server is reachable by others;
# also put it behind HTTPS, since lecturers submit API keys).
# GLOBAL_ACCESS_TOKEN=change-me

# Origins allowed to call the API cross-origin, comma-separated (default "*"). With the UI on
# Vercel, set it to that site, e.g. https://your-app.vercel.app
# GLOBAL_CORS_ORIGINS=https://your-app.vercel.app

# Fernet key for encrypting lecturer credentials at rest. Default: generated into data/secret.key.
# GLOBAL_SECRET_KEY=

# "fake" simulates the teacher LLM offline (demos / tests): no API key needed, no cost.
# For a demo run, uncomment the next line.
# GLOBAL_TEACHER_BACKEND=fake

# Fraction of GPU memory the training process may use (headroom for the desktop compositor).
# GLOBAL_VRAM_FRACTION=0.85
