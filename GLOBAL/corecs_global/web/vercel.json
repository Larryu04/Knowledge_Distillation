{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build-config.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
